# Settings for docker compose. Copy this file to .env and fill it in.

# Spotify developer dashboard: create an app, add the redirect URI http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_DEVICE_NAME=Speakerdeck

OCTOPRINT_URL=http://127.0.0.1:5000
OCTOPRINT_API_KEY=

# 90 or 270, whichever is the right way up.
DISPLAY_ROTATE=90
# Set to 1 if touches land mirrored.
TOUCH_INVERT_X=0
TOUCH_INVERT_Y=0
TOUCH_SWAP_XY=0

# The volume slider, here and in the Spotify app, covers this window of decibels of the amp:
# 0% is mute, 1% is just above the floor, 100% is the ceiling. Raise the ceiling for more volume.
VOLUME_FLOOR_DB=-40
VOLUME_CEIL_DB=-10
# Another limit, in percent of that window.
MAX_VOLUME=100
PREHEAT_TOOL=200
PREHEAT_BED=60

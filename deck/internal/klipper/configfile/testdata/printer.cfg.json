 [
  "gcode_macro NOZZLE_WIPE",
  [
   [
    "gcode",
    "\nSAVE_GCODE_STATE NAME=wipe\nG90\nG1 Z10 F1200\nG1 X-15 Y95 F6000\nG1 Z1 F600\n{% for i in range(12) %}\nG1 X-17 Y25 F3000\nG1 X-15 Y95 F3000\n{% endfor %}\nG1 Z10 F1200\nRESTORE_GCODE_STATE NAME=wipe"
   ]
  ]
 ],
 [
  "gcode_macro PRINT_START",
  [
   [
    "gcode",
    "\n{% set bed = params.BED|default(80)|float %}\n{% set extruder = params.EXTRUDER|default(235)|float %}\n{% set wipe = params.WIPE|default(170)|float %}\n{% set layer = params.LAYER|default(0.4)|float %}\n{% set probe = params.PROBE|default(120)|float %}\n{% set speed = params.SPEED|default(15)|float %}\n{% set prime_lines = 2 %}\n{% set prime_x0, prime_x1, prime_y0, prime_w = 20.0, 260.0, 2.0, 0.6 %}\n\n\n{% set prime_e = prime_w * layer / 6.379 %}\n{% set prime_speed = [speed, 15.0 / (prime_w * layer)]|min %}\nM107\nG90\nM82\nG92 E0\nM104 S{wipe}\nM140 S{bed}\nG28\nM117 Heating...\n\n\nTEMPERATURE_WAIT SENSOR=extruder MINIMUM={wipe - 2}\nM83\nG1 E-3 F500\nM106 S255\nM117 Wiping nozzle...\nNOZZLE_WIPE\n\nM104 S0\nM117 Cooling nozzle...\nTEMPERATURE_WAIT SENSOR=extruder MAXIMUM={probe}\nM107\nM117 Probing...\nBED_TILT_CALIBRATE\nM104 S{extruder}\nG1 X{prime_x0} Y{prime_y0} Z10 F5000\nM117 Heating...\nTEMPERATURE_WAIT SENSOR=heater_bed MINIMUM={bed - 1}\nTEMPERATURE_WAIT SENSOR=extruder MINIMUM={extruder - 2}\n\nM117 Priming {prime_lines} lines...\nG0 Z{layer} F1500\nG1 E4 F300\n{% for i in range(prime_lines) %}\n{% set x = prime_x1 if i % 2 == 0 else prime_x0 %}\nG1 X{x} E{(prime_x1 - prime_x0) * prime_e} F{prime_speed * 60}\nG1 Y{prime_y0 + (i + 1) * prime_w} E{prime_w * prime_e} F{prime_speed * 60}\n{% endfor %}\n{% set x_end = prime_x1 if prime_lines % 2 == 1 else prime_x0 %}\nG1 X{x_end - 20 if x_end > prime_x0 else x_end + 20} Z{layer + 0.3} F3000\nM82\nG92 E1\nG1 E0 F1800\nM117 Printing..."
   ]
  ]
 ],
 [
  "gcode_macro PRINT_END",
  [
   [
    "gcode",
    "\nM400\nM140 S45\nM104 S0\nM107\nG91\nG1 Z10 F1200\nG90\nG1 X145 Y0 F3000\nM83\nG1 E-14 F1800\nM82\nM117 Cooling, please wait\nTEMPERATURE_WAIT SENSOR=heater_bed MAXIMUM=46\nG1 Y260 F1000\nM140 S0\nM84\nM117 Print complete"
   ]
  ]
 ],

# Settings for the setup scripts. Edit this file before you run them.

# Device tree overlay for the HiFiBerry model. Examples:
#   hifiberry-dacplus-std   DAC+ Standard, DAC2 HD, Amp2
#   hifiberry-dacplus-pro   DAC+ Pro, DAC2 Pro, Amp4 Pro
#   hifiberry-dac           DAC+ Light, DAC Zero, MiniAmp
# This build uses the Amp2.
HIFIBERRY_OVERLAY="hifiberry-dacplus-std"

# The Amp2 powers the Pi through the header, so the Pi does not see a 5 A supply.
# Without this setting, all USB ports together get only 600 mA,
# which is not sufficient for the SSD and the display.
USB_MAX_CURRENT=1

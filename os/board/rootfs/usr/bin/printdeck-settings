#!/bin/sh
# Applies the settings in printdeck.txt on the config partition, then clears the Wi-Fi password in it.
set -eu

mount /boot/config
trap 'umount /boot/config' EXIT

# A printer.cfg on the config partition becomes the Klipper configuration. The include of the
# Printdeck sections goes at the end, so its settings win (for example the upload folder). The file
# on the partition gets the name printer.cfg.imported, so a later SAVE_CONFIG on the Pi stays.
if [ -f /boot/config/printer.cfg ]; then
  mkdir -p /var/lib/klipper/config
  {
    tr -d '\r' < /boot/config/printer.cfg
    printf '\n# Added by Printdeck: keep this line last.\n[include /usr/share/printdeck/klipper/printdeck.cfg]\n'
  } > /var/lib/klipper/config/printer.cfg.new
  mv /var/lib/klipper/config/printer.cfg.new /var/lib/klipper/config/printer.cfg
  chown -R printer:printer /var/lib/klipper/config
  mv /boot/config/printer.cfg /boot/config/printer.cfg.imported
fi

FILE=/boot/config/printdeck.txt
[ -f "$FILE" ] || exit 0

get() {
  sed -n "s/^$1=//p" "$FILE" | tail -n 1 | tr -d '\r'
}

SSID=$(get wifi_ssid)
if [ -n "$SSID" ]; then
  # Apply the network again only when a password is in the file, or for an open network at the
  # first boot. Otherwise each boot writes the same network again with no password.
  PASS=$(get wifi_password)
  if [ -n "$PASS" ] || ! grep -q '^network=' /etc/wpa_supplicant/wpa_supplicant-wlan0.conf; then
    printdeck-wifi "$SSID" "$PASS" "$(get wifi_country)" || echo "Wi-Fi: not applied" >&2
  fi
fi

# printdeck-credentials makes the user "printdeck". A key here lets it log in with SSH.
KEY=$(get ssh_key)
if [ -n "$KEY" ]; then
  printdeck-user printdeck "" "$KEY" || echo "SSH key: not applied" >&2
fi

# The touch screen links Spotify with a QR code. It needs the client ID of a Spotify app.
SPOTIFY=$(get spotify_client_id)
if [ -n "$SPOTIFY" ]; then
  mkdir -p /var/lib/printdeck
  printf 'SPOTIFY_CLIENT_ID=%s\n' "$SPOTIFY" > /var/lib/printdeck/spotify.env
fi

HOST=$(get hostname)
if [ -n "$HOST" ] && [ "$HOST" != "$(cat /etc/hostname 2> /dev/null)" ]; then
  echo "$HOST" > /etc/hostname
  hostname "$HOST"
fi

TZ_NAME=$(get timezone)
if [ -n "$TZ_NAME" ] && [ -f "/usr/share/zoneinfo/$TZ_NAME" ]; then
  ln -sf "/usr/share/zoneinfo/$TZ_NAME" /etc/localtime
fi

# With the Wi-Fi set here, the touch screen does not open its setup screen.
if [ -n "$SSID" ]; then
  mkdir -p /var/lib/printdeck
  touch /var/lib/printdeck/setup-done
fi

# The file is on a FAT partition that any computer can read. Do not keep the password in it.
sed -i 's/^wifi_password=.*/wifi_password=/' "$FILE"

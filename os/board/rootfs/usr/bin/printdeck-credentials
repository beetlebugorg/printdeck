#!/bin/sh
# Makes the login of this Printdeck at the first start:
#
#   - the user "printdeck" for SSH, sudo and the remote screen, with a random password of four words
#   - the key of the OctoPrint-compatible API, for slicers
#
# The touch screen shows the password (Print > Control > Help). It is in /var/lib/printdeck/password.
# To change it, run "passwd" over SSH.
set -eu

DIR=/var/lib/printdeck
USER_NAME=printdeck

mkdir -p "$DIR"
chmod 0700 "$DIR"

if [ ! -s "$DIR/password" ]; then
  PASS=$(printdeck password)
  printdeck-user "$USER_NAME" "$PASS"
  printf '%s\n' "$PASS" > "$DIR/password.new"
  chmod 0600 "$DIR/password.new"
  mv "$DIR/password.new" "$DIR/password"
fi

# The key of the OctoPrint-compatible API, for slicers that take a key (OrcaSlicer, PrusaSlicer).
# printdeck-deck.service reads it from api.env.
if [ ! -s "$DIR/api.env" ]; then
  KEY=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
  printf 'OCTOPRINT_API_KEY=%s\n' "$KEY" > "$DIR/api.env.new"
  chmod 0600 "$DIR/api.env.new"
  mv "$DIR/api.env.new" "$DIR/api.env"
fi

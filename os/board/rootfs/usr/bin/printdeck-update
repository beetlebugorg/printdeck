#!/bin/sh
# Writes an update bundle to the other slot and restarts into it one time.
#
#   printdeck-update printdeck-update.tar
#
# After the restart, printdeck-commit makes the new slot the default if the services start.
# If the new system does not start, the next restart returns to the current slot.
set -eu

[ $# -eq 1 ] || { echo "Usage: printdeck-update printdeck-update.tar" >&2; exit 2; }
BUNDLE=$1

CURRENT=$(sed -n 's/.*printdeck\.slot=\([ab]\).*/\1/p' /proc/cmdline)
case "$CURRENT" in
  a) NEW=b ;;
  b) NEW=a ;;
  *) echo "The kernel command line has no printdeck.slot." >&2; exit 1 ;;
esac

WORK=$(mktemp -d /data/update.XXXXXX)
trap 'rm -rf "$WORK"' EXIT
tar -xf "$BUNDLE" -C "$WORK"
(cd "$WORK" && sha256sum -c -s SHA256SUMS) || { echo "The bundle is damaged." >&2; exit 1; }

echo "Writing slot $NEW."
dd if="$WORK/boot-$NEW.vfat" of="/dev/disk/by-partlabel/printdeck-boot-$NEW" bs=4M conv=fsync 2> /dev/null
dd if="$WORK/rootfs.erofs" of="/dev/disk/by-partlabel/printdeck-root-$NEW" bs=4M conv=fsync 2> /dev/null
sync

echo "Restarting into slot $NEW."
# The reboot argument "0 tryboot" makes the firmware start the tryboot partition one time. systemd 257
# accepts it only with --reboot-argument.
systemctl reboot --reboot-argument="0 tryboot"

#!/bin/sh
# The first program at boot (init= on the kernel command line). The root file system is read-only.
# This script mounts the data partition, puts writable layers from it over /etc, /var, /home and
# /root, and then starts systemd.
PATH=/usr/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

# Messages go to the kernel log, so they are in the journal but not on the start screen.
say() {
  echo "printdeck-init: $1" > /dev/kmsg
}

# Print the device name of the partition with this GPT partition name.
partition() {
  for u in /sys/class/block/*/uevent; do
    if grep -qx "PARTNAME=$1" "$u"; then
      sed -n 's/^DEVNAME=//p' "$u"
      return 0
    fi
  done
  return 1
}

rescue() {
  say "$1. Starting a shell."
  echo "printdeck-init: $1. Starting a shell." > /dev/console
  # Keep the message and the kernel log on the config partition, where a computer can read them.
  if CONFIG=$(partition printdeck-config) && mount -t vfat "/dev/$CONFIG" /boot/config; then
    { echo "printdeck-init: $1"; dmesg; } > /boot/config/printdeck-boot.log
    umount /boot/config
  fi
  exec /bin/sh < /dev/console > /dev/console 2>&1
}

say "starting"
DATA=$(partition printdeck-data) || rescue "No printdeck-data partition"
DISK=$(basename "$(dirname "$(readlink -f "/sys/class/block/$DATA")")")
NUM=$(cat "/sys/class/block/$DATA/partition")

# At the first boot, grow the data partition to the end of the disk. The sizes are in
# 512-byte sectors. Grow only when more than 64 MiB is free after the partition.
# The partition is empty at the first boot, so make a new file system on it. resize2fs writes all
# the inode tables of the large disk at once, which takes minutes over USB. mke2fs with lazy
# inode tables takes seconds, and the kernel fills them in later.
START=$(cat "/sys/class/block/$DATA/start")
SIZE=$(cat "/sys/class/block/$DATA/size")
END=$(cat "/sys/class/block/$DISK/size")
if [ $((END - START - SIZE)) -gt 131072 ]; then
  say "making the data partition fill the disk"
  sfdisk --quiet --relocate gpt-bak-std "/dev/$DISK"
  echo ", +" | sfdisk --quiet --no-reread --no-tell-kernel -N "$NUM" "/dev/$DISK"
  partx -u -n "$NUM" "/dev/$DISK"
  mke2fs -q -F -t ext4 -L data -E lazy_itable_init=1,lazy_journal_init=1 "/dev/$DATA"
fi

e2fsck -p "/dev/$DATA" > /dev/null
[ $? -lt 4 ] || rescue "The data partition has errors that e2fsck cannot repair"
mount -t ext4 -o noatime "/dev/$DATA" /data || rescue "Cannot mount the data partition"

# The writable layer keeps its own copy of an account file after a change (for example the password
# of the printdeck user), and that copy hides the file of a newer image. Add the users and groups of
# the image to the copies, and the members of the groups of the image. A new user or group whose id
# the copy already uses gets a free id from 100 to 999. A new user gets its group by the name.
merge_accounts() {
  U=/data/etc L=/etc
  if [ -f "$U/group" ]; then
    awk -F: -v OFS=: '
      NR == FNR { up[$1] = 1; used[$3] = 1; next }
      { lo[++n] = $0 }
      END {
        while ((getline l < ARGV[1]) > 0) {
          split(l, f, ":")
          for (k = 1; k <= n; k++) {
            split(lo[k], g, ":")
            if (g[1] != f[1]) continue
            m = split(g[4], want, ",")
            for (i = 1; i <= m; i++)
              if (want[i] != "" && ("," f[4] ",") !~ ("," want[i] ","))
                f[4] = (f[4] == "" ? want[i] : f[4] "," want[i])
          }
          print f[1], f[2], f[3], f[4]
        }
        for (k = 1; k <= n; k++) {
          split(lo[k], g, ":")
          if (g[1] in up) continue
          id = g[3]
          if (id in used) { for (id = 100; id in used; id++); }
          used[id] = 1
          print g[1], g[2], id, g[4]
        }
      }
    ' "$U/group" "$L/group" > "$U/.merge" && cat "$U/.merge" > "$U/group"
  fi
  if [ -f "$U/passwd" ]; then
    awk -F: -v OFS=: '
      FILENAME == ARGV[1] { gid[$1] = $3; next }
      FILENAME == ARGV[2] { gname[$3] = $1; next }
      FILENAME == ARGV[3] { up[$1] = 1; used[$3] = 1; print; next }
      !($1 in up) {
        id = $3
        if (id in used) { for (id = 100; id in used; id++); }
        used[id] = 1
        g = ($4 in gname && gname[$4] in gid) ? gid[gname[$4]] : $4
        print $1, $2, id, g, $5, $6, $7
      }
    ' "$U/group" "$L/group" "$U/passwd" "$L/passwd" > "$U/.merge" && cat "$U/.merge" > "$U/passwd"
  fi
  if [ -f "$U/shadow" ]; then
    awk -F: 'NR == FNR { seen[$1] = 1; next } !($1 in seen)' "$U/shadow" "$L/shadow" > "$U/.merge"
    cat "$U/.merge" >> "$U/shadow"
  fi
  rm -f "$U/.merge"
}
merge_accounts

for d in etc var home root; do
  mkdir -p "/data/$d" "/data/.work/$d"
  mount -t overlay overlay -o "lowerdir=/$d,upperdir=/data/$d,workdir=/data/.work/$d" "/$d" \
    || rescue "Cannot put the writable layer over /$d"
done

# With "quiet" on the kernel command line, show the start screen until the deck starts. A finger on the
# screen at boot shows the boot messages instead.
if grep -qw quiet /proc/cmdline; then
  # shellcheck source=/dev/null
  (set -a; . /etc/printdeck/deck.env; exec printdeck splash) < /dev/null > /dev/null 2>&1 &
fi

exec /usr/lib/systemd/systemd

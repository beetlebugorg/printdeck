[Unit]
Description=Make the Printdeck login at the first start
After=local-fs.target
Before=dropbear.service printdeck-deck.service printdeck-settings.service
ConditionPathExists=|!/var/lib/printdeck/password
ConditionPathExists=|!/var/lib/printdeck/api.env

[Service]
Type=oneshot
ExecStart=/usr/bin/printdeck-credentials

[Install]
WantedBy=multi-user.target

[Unit]
Description=Printdeck touch screen
# The deck does not wait for Klipper or the network. It connects to them when they are ready.
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
# "printdeck splash" makes this file when a finger is on the screen at boot. Then the boot
# messages stay on the screen.
ConditionPathExists=!/dev/.printdeck-diagnostics

[Service]
EnvironmentFile=/etc/printdeck/deck.env
# The API key from printdeck-credentials, and the Spotify client ID from printdeck.txt.
EnvironmentFile=-/var/lib/printdeck/api.env
EnvironmentFile=-/var/lib/printdeck/spotify.env
# The deck runs as the user deck, with the groups of its devices: the framebuffer (video), the
# touch screen (input), the amp (audio), tty1 (tty), and Klipper's socket and uploads (printer).
User=deck
Group=deck
SupplementaryGroups=video input audio tty printer
# Port 80 for the remote screen and the slicers, and the graphics mode of tty1.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_TTY_CONFIG
# The folder also has the password of the printdeck user: only the deck can read it.
StateDirectory=printdeck
StateDirectoryMode=0700
# The Spotify login of the go-librespot program of older images moves into the state folder.
ExecStartPre=+/bin/sh -c 'if [ -d /var/lib/go-librespot ] && [ ! -e /var/lib/printdeck/spotify ]; then cp -a /var/lib/go-librespot /var/lib/printdeck/spotify && rm -f /var/lib/printdeck/spotify/config.yml /var/lib/printdeck/spotify/lockfile && chown -R deck:deck /var/lib/printdeck/spotify; fi'
ExecStart=/usr/bin/printdeck
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

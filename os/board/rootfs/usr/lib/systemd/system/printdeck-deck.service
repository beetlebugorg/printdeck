[Unit]
Description=Printdeck touch screen
# The deck does not wait for Klipper or the network. It connects to them when they are ready.
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
# "printdeck splash" makes this file when a finger is on the screen at boot. Then the boot
# messages stay on the screen.
ConditionPathExists=!/dev/.printdeck-diagnostics

[Service]
EnvironmentFile=/etc/printdeck/deck.env
# The API key from printdeck-credentials.
EnvironmentFile=-/var/lib/printdeck/api.env
# The settings of printdeck.txt that change deck.env (printdeck-settings writes it).
EnvironmentFile=-/var/lib/printdeck/settings.env
# The deck runs as the user deck, with the groups of its devices: the framebuffer (video), the
# touch screen (input), tty1 (tty), Klipper's socket and uploads (printer), the
# USB serial ports, to find the printer board at the setup (dialout), and the journal for the
# system page of the web server (systemd-journal).
User=deck
Group=deck
SupplementaryGroups=video input tty printer dialout systemd-journal
# Port 80 for the remote screen and the slicers, and the graphics mode of tty1. The bounding set
# stays full: sudo runs printdeck-wifi and printdeck-user as root, and needs CAP_SETUID and
# CAP_SETGID for that.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_TTY_CONFIG
# The folder also has the password of the printdeck user: only the deck can read it.
StateDirectory=printdeck
StateDirectoryMode=0700
# The handoff of "Restart the screen now" after an update during a print, in RAM. It stays when
# the deck restarts. It also has a copy of the deck program of the installed update. With the
# marker next.json in it, /usr/bin/printdeck runs that copy in its place. With no marker, it runs
# itself.
RuntimeDirectory=printdeck-deck
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/printdeck
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

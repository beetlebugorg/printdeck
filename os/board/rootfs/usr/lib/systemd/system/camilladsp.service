[Unit]
Description=CamillaDSP equalizer
After=sound.target systemd-modules-load.service

[Service]
User=camilla
Group=camilla
SupplementaryGroups=audio
# The websocket is only for the deck on this host.
ExecStart=/usr/bin/camilladsp -p 1234 -a 127.0.0.1 /usr/share/printdeck/camilladsp.yml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

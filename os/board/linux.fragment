# The root file system and the writable layers, before modules can load.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
# The USB SSD holds the root file system.
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_SD=y
# The deck draws on /dev/fb0.
CONFIG_DRM_FBDEV_EMULATION=y
# The start screen, which the console shows when vc4 starts (fullscreen_logo in cmdline.txt). The
# kernel holds the file, because the root file system is not mounted yet. external.mk copies it
# from board/firmware into the kernel folder.
CONFIG_EXTRA_FIRMWARE="printdeck-logo.tga"
CONFIG_EXTRA_FIRMWARE_DIR="printdeck-firmware"
# depmod reads only uncompressed modules here, so do not compress them. The EROFS root file system
# is compressed already.
# CONFIG_MODULE_COMPRESS is not set
# USB cameras (UVC): webcams and HDMI capture sticks, for the camera of the deck (V4L2). Only the
# UVC driver and the V4L2 core: no TV, no camera port, and no other media drivers.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
# CONFIG_VIDEO_CAMERA_SENSOR is not set
# CONFIG_VIDEO_CAMERA_LENS is not set
# CONFIG_VIDEO_IR_I2C is not set
CONFIG_VIDEO_DEV=m
CONFIG_USB_VIDEO_CLASS=m
# CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV is not set
